{
  "name": "gemini-docs-change-tracker",
  "version": "1.0.0",
  "description": "Change detection and tracking system for Gemini API documentation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "track": "npm run build && node dist/index.js track",
    "diff": "npm run build && node dist/index.js diff",
    "changelog": "npm run build && node dist/index.js changelog",
    "dev": "ts-node src/index.ts",
    "test": "jest"
  },
  "keywords": [
    "gemini",
    "api",
    "change-tracking",
    "diff",
    "changelog"
  ],
  "author": "Gemini Docs Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "diff": "^5.1.0",
    "date-fns": "^2.30.0",
    "js-yaml": "^4.1.0",
    "glob": "^10.3.10",
    "crypto": "^1.0.1",
    "marked": "^9.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/diff": "^5.0.8",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
