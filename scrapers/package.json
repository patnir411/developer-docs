{
  "name": "gemini-docs-scraper",
  "version": "1.0.0",
  "description": "Automated web scraper for Gemini API documentation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "scrape": "npm run build && node dist/index.js scrape",
    "scrape:all": "npm run build && node dist/index.js scrape --all",
    "scrape:gemini": "npm run build && node dist/index.js scrape --source=gemini",
    "scrape:vertex": "npm run build && node dist/index.js scrape --source=vertex",
    "scrape:python": "npm run build && node dist/index.js scrape --source=python",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "gemini",
    "api",
    "documentation",
    "scraper",
    "automation"
  ],
  "author": "Gemini Docs Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.5.0",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "p-limit": "^3.1.0",
    "p-retry": "^5.1.2",
    "date-fns": "^2.30.0",
    "turndown": "^7.1.2",
    "marked": "^9.1.6",
    "js-yaml": "^4.1.0",
    "node-cache": "^5.1.2",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
