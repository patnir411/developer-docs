{
  "name": "gemini-docs-cli",
  "version": "1.0.0",
  "description": "Interactive CLI for exploring Gemini API documentation",
  "main": "dist/index.js",
  "bin": {
    "gemini-docs": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "link": "npm run build && npm link"
  },
  "keywords": [
    "gemini",
    "api",
    "cli",
    "documentation",
    "reference"
  ],
  "author": "Gemini Docs Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.5",
    "fuzzy": "^0.1.3",
    "marked": "^9.1.6",
    "marked-terminal": "^6.0.0",
    "glob": "^10.3.10",
    "date-fns": "^2.30.0",
    "table": "^6.8.1",
    "cli-highlight": "^2.1.11",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/inquirer": "^8.2.10",
    "@types/fuzzy": "^0.5.7",
    "@types/marked": "^5.0.2",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
